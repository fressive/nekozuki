# API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: route LLM / embedding requests through a gateway or proxy.
# Leave empty to use the provider defaults.
# BASE_URL=https://api.anthropic.com
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# LLM Configuration
# NOTE: LLM_MAX_TOKENS is the per-request OUTPUT budget (not the context window).
# Keep it sane (4k-32k) — huge values (>64k) make the Anthropic SDK demand
# streaming and exceed gateway output caps.
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.3
LLM_MAX_CONCURRENCY=8
LLM_BATCH_SIZE=20
LLM_MAX_BATCH_TOKENS=25000
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT=120

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
HYBRID_BM25_WEIGHT=0.3
HYBRID_EMBEDDING_WEIGHT=0.7
TOP_K=10

# Filtering
MIN_CONTENT_LENGTH=500

# Auth: set to enable login for admin (non-search) endpoints/pages.
# Empty = auth disabled (everything open).
# AUTH_PASSWORD=change-me

# Data Paths
DATA_PATH=data.json
OUTPUT_DIR=output